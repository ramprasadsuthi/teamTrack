# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# Persistent JSON Storage Directory
# In production on AWS EC2 or VPS, specify a persistent mount point:
# DATA_DIR=/var/data/teamtrack
DATA_DIR=./data

# Organization Default Timezone (for date comparisons and deadline monitoring)
APP_TIMEZONE=Asia/Kolkata

# Application URL
APP_URL="http://localhost:3000"

# Optional GEMINI_API_KEY if AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"
